# Kirana Smart Stock - Environment Configuration Example
# Backend Django Settings
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgres://postgres:password@localhost:5432/kirana_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Settings (optional override)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
